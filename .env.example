# ──────────────────────────────────────────────
#  call-gate  ·  Environment Variable Template
#  Copy this file to .env and fill in your keys.
#  NEVER commit .env to source control.
# ──────────────────────────────────────────────

# GMGN API key — used for token analytics (holder distribution,
# dev history, liquidity, bundler %, LP lock status, honeypot checks)
GMGN_API_KEY=your_gmgn_api_key_here

# Solana RPC endpoint (mainnet-beta)
# e.g. https://api.mainnet-beta.solana.com  or a private Helius/Triton URL
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# EVM RPC endpoint — used for Ethereum-compatible chains (BSC, ETH, Base, etc.)
# e.g. https://bsc-dataseed.binance.org/
EVM_RPC_URL=https://mainnet.infura.io/v3/YOUR_INFURA_PROJECT_ID

# Robinhood Chain RPC endpoint (if applicable)
ROBINHOOD_CHAIN_RPC_URL=https://your-robinhood-chain-rpc-url-here
